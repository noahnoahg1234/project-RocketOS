#!/bin/sh
# Started by startx: sets up the display, then runs the RocketOS shell fullscreen.
xset s off -dpms s noblank 2>/dev/null
xsetroot -solid '#05060f' -cursor_name left_ptr 2>/dev/null
# WebKit's DMA-BUF renderer shows a blank window on many VMs/simple GPUs.
export WEBKIT_DISABLE_DMABUF_RENDERER=1
[ -e /dev/dri/card0 ] || export ROCKETOS_SOFTWARE=1
exec /usr/bin/python3 /usr/lib/rocketos/rocket-shell.py >>"$HOME/.rocketos-shell.log" 2>&1
